# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.

# Base URL of your Vercel deployment (no trailing slash)
API_BASE_URL=https://your-app.vercel.app

# Random secret shared between the extension and the Vercel API endpoint.
# Generate with: openssl rand -hex 32
INSTALL_LOG_API_KEY=replace-with-your-secret
