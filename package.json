{
  "name": "linkedin-extension",
  "version": "1.0.0",
  "description": "Chrome extension for LinkedIn",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "coverage": "jest --coverage",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,css,html}\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.290",
    "@types/jest": "^30.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "mini-css-extract-plugin": "^2.9.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "idb": "^8.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,html}": "prettier --write"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "functions": 90,
        "branches": 90,
        "statements": 90
      }
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2
  }
}
